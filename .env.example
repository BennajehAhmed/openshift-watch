# Uses your existing oc login. Never put a token in this file.
PORT=3100
OC_BIN=oc
# Optional absolute path to an existing kubeconfig; never copy it into this project.
# KUBECONFIG=C:\Users\you\.kube\config
# Optional context. If blank, the current context is pinned at startup.
OC_CONTEXT=
# Comma-separated namespaces; if blank, select projects in the dashboard.
NAMESPACES=
POLL_SECONDS=30
COMMAND_TIMEOUT_SECONDS=15
# Consecutive failed observations before creating an incident.
ALERT_AFTER_CHECKS=2
# true: also alert for partial replica loss / unhealthy individual pods.
ALERT_ON_DEGRADED=true
